{
  "name": "handoffglass",
  "version": "0.15.0",
  "private": true,
  "description": "Single-instance visual handoff broker for MCP agents with owned human decisions and safe desktop overlays",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "handoffglass": "./src/mcp.mjs"
  },
  "scripts": {
    "start": "node src/mcp.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/server.mjs",
    "check": "npm run check:syntax && npm run check:repo",
    "verify": "npm run check && npm test",
    "doctor": "node scripts/doctor.mjs",
    "test:integration": "node scripts/mcp-smoke.mjs",
    "desktop:demo": "node scripts/desktop-demo.mjs",
    "broker:status": "node scripts/broker-control.mjs status",
    "broker:stop": "node scripts/broker-control.mjs stop",
    "configure": "node scripts/configure.mjs all",
    "configure:claude": "node scripts/configure.mjs claude",
    "configure:codex": "node scripts/configure.mjs codex",
    "configure:cursor": "node scripts/configure.mjs cursor",
    "configure:vscode": "node scripts/configure.mjs vscode",
    "configure:gemini": "node scripts/configure.mjs gemini",
    "configure:zed": "node scripts/configure.mjs zed",
    "install:desktop": "npm install --include=optional",
    "bench:broker": "node scripts/benchmark.mjs",
    "install:host": "node scripts/install-host.mjs",
    "gallery": "node scripts/gallery.mjs",
    "scene:templates": "node scripts/scene.mjs list",
    "scene:lint": "node scripts/scene.mjs validate examples/scenes/access-review.json && node scripts/scene.mjs validate examples/scenes/tutorial.json && node scripts/scene.mjs validate examples/scenes/multi-monitor.json",
    "build:overlay": "node scripts/build-overlay.mjs",
    "native:macos": "node scripts/build-native-macos.mjs",
    "build:desktop": "npm run build:icons && node scripts/build-overlay.mjs && npx --yes electron-builder@26.0.12 --dir --config electron-builder.config.cjs",
    "dist:desktop": "npm run build:icons && node scripts/build-overlay.mjs && npx --yes electron-builder@26.0.12 --config electron-builder.config.cjs",
    "accessibility": "node scripts/accessibility.mjs status",
    "configure:opencode": "node scripts/configure.mjs opencode",
    "configure:cline": "node scripts/configure.mjs cline",
    "configure:windsurf": "node scripts/configure.mjs windsurf",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:packaged": "node scripts/packaged-mcp-smoke.mjs",
    "preferences": "node scripts/preferences.mjs",
    "blueprints": "node scripts/blueprints.mjs",
    "test:local": "node --test test/local-*.test.mjs",
    "host:matrix": "node scripts/host-matrix.mjs",
    "harness:deepseek": "node scripts/prepare-deepseek.mjs",
    "connector:workbuddy": "node scripts/build-workbuddy.mjs",
    "test:extras": "node scripts/mcp-smoke.mjs --extras",
    "readiness": "node scripts/readiness.mjs",
    "bench:context": "node scripts/context-budget.mjs",
    "site:preview": "node scripts/site-preview.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "connection:check": "node scripts/connection-check.mjs",
    "check:syntax": "node scripts/check-syntax.mjs && node scripts/build-overlay.mjs --check",
    "check:repo": "node scripts/check-repo.mjs",
    "handoff:check": "npm run verify && npm run scene:lint"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "optionalDependencies": {
    "electron": "^44.8.0"
  },
  "main": "src/desktop/app.mjs"
}
